# Runtime connection used by the NestJS backend. Use the Supabase pooled
# PostgreSQL connection string in production.
DATABASE_URL=

# Direct PostgreSQL connection used only by Prisma CLI migrations.
DIRECT_URL=

# Server-side Supabase project URL and service-role/secret key. Never prefix
# SUPABASE_SECRET with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_URL=
SUPABASE_SECRET=

# Configure at least one LLM API key. Auto-detection order is OpenRouter,
# Google, then OpenAI.
OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional LLM overrides.
# LLM_PROVIDER=
# LLM_MODEL=
# OPENAI_API_URL=

# Required only when using backend/docker-compose.yml for the fallback local
# PostgreSQL service. It is not needed when DATABASE_URL points to Supabase.
POSTGRES_PASSWORD=
