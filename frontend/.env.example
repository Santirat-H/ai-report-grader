# Required when deploying the Next.js frontend to Vercel.
# Use the public HTTPS origin of the separately hosted NestJS backend.
# Do not include /api/backend or a trailing slash.
BACKEND_URL=

# Legacy Docker/DigitalOcean compatibility only. Prefer BACKEND_URL for new
# deployments because this value does not need to be exposed to browser code.
# NEXT_PUBLIC_BACKEND_URL=
